# Copy to deploy/mockinterview.env (gitignored) and fill in. Master deploy config.

# --- GCP project (reuses the StoryBytes project + shared Cloud SQL) ---
PROJECT_ID=storybytes-495010
REGION=us-west1
SERVICE=mockinterview-api

# Shared Cloud SQL Postgres instance connection name: PROJECT:REGION:INSTANCE.
# Find it with:  gcloud sql instances list --project=$PROJECT_ID
CLOUDSQL_INSTANCE=storybytes-495010:us-west1:CHANGE_ME

# App's own database + least-privilege user on that shared instance.
DB_NAME=mockinterview
DB_USER=mockinterview
DB_PASSWORD=CHANGE_ME_STRONG

# App secrets.
JWT_SECRET=CHANGE_ME_LONG_RANDOM

# LLM: the reasoning provider + the (Gemini) live voice.
LLM_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL_LIVE=gemini-2.5-flash-native-audio-preview-12-2025
# Optional alternate providers (leave blank unless LLM_PROVIDER points at them):
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Web (Firebase Hosting) ---
FIREBASE_PROJECT=storybytes-495010
# The deployed API base the web app calls (filled after the API deploys, or your
# custom domain, e.g. https://api.mockinterview.live):
WEB_API_BASE=https://mockinterview-api-XXXX.us-west1.run.app
