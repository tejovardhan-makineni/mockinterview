# Copy to deploy/mockinterview.env (gitignored). Never commit filled credentials.
PROJECT_ID=your-gcp-project
FIREBASE_PROJECT=your-gcp-project
REGION=us-west1
SERVICE=mockinterview-api
CLOUDSQL_INSTANCE=your-gcp-project:us-west1:your-existing-instance
DB_NAME=mockinterview
DB_USER=mockinterview
# Required only for a NEW user: precreate/review this NOLOGIN PostgreSQL role.
# Cloud SQL's default new-user roles are too broad for a shared instance.
DB_OWNER_ROLE=mockinterview_owner
DB_PASSWORD=
JWT_SECRET=
SESSION_ENCRYPTION_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_MODEL_LIVE=gemini-2.5-flash-native-audio-preview-12-2025
# Set the selected reasoning provider key if not Gemini.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
META_API_KEY=
# Verification/recovery sender. Domain must be verified with the mail service.
MAIL_PROVIDER=resend
MAIL_FROM=
RESEND_API_KEY=
# Or MAIL_PROVIDER=smtp, with STARTTLS credentials:
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
PUBLIC_URL=https://mockinterview.live
CORS_ALLOW=https://mockinterview.live,https://mockinterview-web.web.app
WEB_API_BASE=https://your-api-service.run.app
HOSTED_DAILY_START_LIMIT=50
MIN_INSTANCES=1
# Isolated staging overrides (separate database/user, JWT/key secrets and service):
# TARGET_SERVICE=mockinterview-api-staging
# DB_NAME=mockinterview_staging
# DB_USER=mockinterview_staging
# DB_OWNER_ROLE=mockinterview_staging_owner
# DB_PASSWORD=<separate strong staging password>
# SECRET_PREFIX=mockinterview-staging
# RUNTIME_ACCOUNT_ID=mockinterview-staging
# RUNTIME_SA=mockinterview-staging@your-gcp-project.iam.gserviceaccount.com
# MIN_INSTANCES=0
