# Copy to .env for local development. No key is needed for deterministic demo
# mode. Live voice needs GEMINI_API_KEY; another scoring provider also needs
# its own key. Demo scores are examples, not an assessment.

# --- Gemini (the default; also powers the live native-audio VOICE) ---
GEMINI_API_KEY=
GEMINI_MODEL_REASON=gemini-3.8-flash
GEMINI_MODEL_CHEAP=gemini-flash-lite-latest
GEMINI_MODEL_LIVE=gemini-3.8-live
GEMINI_MODEL_TTS=gemini-3.8-flash-tts

# --- Reasoning/scoring/review LLM provider (SWAPPABLE) ---
# LLM_PROVIDER = gemini | openai | deepseek | xai | meta | anthropic
# The live voice always uses Gemini regardless of this setting.
LLM_PROVIDER=gemini
# Optional model override; empty => provider default
# (gemini-3.8-flash / gpt-4o-mini / deepseek-chat / grok-4 / claude-sonnet-5).
LLM_MODEL=
# Optional base URL override for OpenAI-compatible endpoints.
LLM_BASE_URL=
# Keys for non-Gemini providers (only the selected provider's key is needed).
# Run `make check-llm` to verify every key present here actually works.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
META_API_KEY=
ANTHROPIC_API_KEY=

# Set true to force the development demo even if a key is present.
# Production rejects demo mode and missing provider keys.
USE_STUB_LLM=false

# --- Server ---
PORT=8080
CORS_ALLOW=http://localhost:3000

# --- Local server and storage ---
# node scripts/local.mjs uses temporary memory storage and binds to loopback.
# --persistent uses PostgreSQL. LOCAL_MEMORY is rejected in production.
LOCAL_MEMORY=false
# Empty uses loopback in development and all interfaces in production.
# Docker Compose explicitly overrides this to 0.0.0.0 inside the API container.
LISTEN_HOST=

# --- Database (defaults match docker-compose) ---
DATABASE_URL=postgres://mockinterview:mockinterview@localhost:5432/mockinterview?sslmode=disable
DB_MAX_CONNS=10

# --- Auth ---
# In production (APP_ENV=production) the server REFUSES to start unless JWT_SECRET
# is set to a strong value (>=32 chars) — never ship the default.
APP_ENV=development
LOCAL_UNLIMITED=true
PUBLIC_URL=http://localhost:3000
JWT_SECRET=dev-insecure-change-me
JWT_TTL_HOURS=168

# Required in production: 32 random bytes encoded as base64, stored in Secret
# Manager. Development generates an in-memory key if omitted; set a stable value
# locally to resume personal-key sessions after API restarts. See README.
# Used for short-lived encrypted own-key session credentials.
SESSION_ENCRYPTION_KEY=
# Global platform-funded interview cap per UTC calendar day (maximum 200).
# Each standard hosted identity has one free interview in total.
HOSTED_DAILY_START_LIMIT=200

# Production verification/recovery mail: set MAIL_FROM and either Resend or SMTP.
# Development returns action links directly, so these are unnecessary locally.
MAIL_FROM=
RESEND_API_KEY=
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Corpus ---
CORPUS_DIR=data/corpus
PACKS_DIR=data/packs

# Every production release sets this to its exact source commit.
RELEASE_SHA=development

# Optional support contact for a self-hosted web app. Set this in web/.env.local
# or the environment used to build the web app. Defaults to the public project
# maintainer, whose account/data support covers mockinterview.live only.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional remote analytics for local web users: set in web/.env.local.
# HTTPS origin only. Users must sign in separately and enable Share analytics.
# Leaving this empty does not send local results to a central project server.
NEXT_PUBLIC_ANALYTICS_API_BASE=
