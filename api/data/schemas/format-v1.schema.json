{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Mockinterview format v1",
  "required": [
    "schema_version",
    "id",
    "revision",
    "name",
    "interviewer_role",
    "workspaces",
    "tool_policy",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "interviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "coding",
          "written",
          "system_design",
          "conversational"
        ]
      }
    },
    "tool_policy": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "guidance",
          "share"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "guidance": {
            "type": "string",
            "minLength": 1
          },
          "share": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
