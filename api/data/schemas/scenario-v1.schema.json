{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Mockinterview scenario v1",
  "required": [
    "schema_version",
    "revision",
    "id",
    "title",
    "track",
    "domain",
    "areas",
    "modality",
    "difficulty",
    "format_id",
    "minutes",
    "review_status",
    "tags",
    "prompt",
    "blurb",
    "interviewer_notes",
    "reference",
    "rubric",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "enum": [
        "engineering",
        "professional"
      ]
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "software_engineering",
          "data_science",
          "product_management",
          "medicine",
          "nursing",
          "law",
          "consulting",
          "finance",
          "mechanical_engineering",
          "electrical_engineering",
          "civil_engineering",
          "ux_design",
          "sales",
          "marketing",
          "human_resources",
          "education"
        ]
      }
    },
    "modality": {
      "enum": [
        "coding",
        "written",
        "system_design",
        "conversational"
      ]
    },
    "difficulty": {
      "enum": [
        "entry",
        "junior",
        "mid",
        "senior",
        "staff"
      ]
    },
    "format_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "minutes": {
      "type": "integer",
      "minimum": 3,
      "maximum": 90
    },
    "review_status": {
      "enum": [
        "preview",
        "reviewed"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "blurb": {
      "type": "string",
      "minLength": 1
    },
    "interviewer_notes": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "object",
      "minProperties": 1
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "description",
          "weight"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5
          },
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "0": {
                "type": "string",
                "minLength": 1
              },
              "1": {
                "type": "string",
                "minLength": 1
              },
              "2": {
                "type": "string",
                "minLength": 1
              },
              "3": {
                "type": "string",
                "minLength": 1
              },
              "4": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorship",
        "license"
      ],
      "properties": {
        "authorship": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "learning_drills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "prompt",
          "minutes",
          "checklist"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "checklist": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
